<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-seed-default-rooms" author="rahul">
        <insert tableName="chat_rooms">
            <column name="name" value="general"/>
            <column name="description" value="Talk about anything"/>
        </insert>
        <insert tableName="chat_rooms">
            <column name="name" value="random"/>
            <column name="description" value="Off-topic fun"/>
        </insert>
        <rollback>
            <delete tableName="chat_rooms">
                <where>name IN ('general', 'random')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
